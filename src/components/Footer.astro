---
import {Socials, Links} from "../data/scripts/database"
---

<div class="pr-[0.65em] pl-[0.65em] mb-[0.65em] mt-[0.65em]">
<footer class="footer footer-horizontal footer-center bg-base-300 p-5 gap-2 rounded-md">
  <aside>
    <p>
      &copy; TTNRT Corporation {new Date().getFullYear()}. All rights reserved.
      <br />
      Made with <span class="iconify fa6-solid--heart text-base text-red-500"></span> in Michigan.
    </p>
  </aside>
  <nav>
    <div class="flex grid-flow-col gap-4">
      {Socials.map((item) => (
        <div>
          <a class="text-xl" href={item.link} target="_blank" title={item.title} rel="me">
            <span class={`iconify ${item.icon}`}></span>
          </a>
        </div>
      ))}
    </div>
    <div class="flex grid-flow-col gap-4">
      {Links.map((item) => (
        <div>
          <a role="button" rel="me" target="_blank" href={item.link}>
            {item.title}
          </a>
        </div>
      ))}
    </div>
  </nav>
</footer>
</div>